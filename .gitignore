# Unity: folders Unity generates. Ignored whether the Unity project is at the top of the
# repo or one folder down (where Unity Hub puts it), but never inside Assets.
/[Ll]ibrary/
/*/[Ll]ibrary/
/[Tt]emp/
/*/[Tt]emp/
/[Oo]bj/
/*/[Oo]bj/
/[Bb]uild/
/*/[Bb]uild/
/[Bb]uilds/
/*/[Bb]uilds/
/[Ll]ogs/
/*/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/*/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/*/[Mm]emoryCaptures/
/[Rr]ecordings/
/*/[Rr]ecordings/
# ...so a folder called Build or Logs that you make inside Assets is still kept
![Aa]ssets/**
!/*/[Aa]ssets/**

# Code editor files (Visual Studio, Rider, VS Code) that Unity regenerates
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Builds and exports
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# Operating system and backup files
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.blend1
